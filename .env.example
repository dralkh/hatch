# Optional. Browser users can paste their own key into the page instead.
# Configure this as a Cloudflare secret for a shared deployment:
#   npx wrangler secret put FAL_KEY
FAL_KEY=

# Self-hosted web providers. Leave an endpoint blank to hide that provider.
# For npm run dev, the engine is commonly reachable on 127.0.0.1.
# In Docker, use host.docker.internal and add the host-gateway mapping shown
# in README.md.
COMFYUI_ENDPOINT=
COMFYUI_TOKEN=
COMFYUI_TEXT_WORKFLOW=
COMFYUI_EDIT_WORKFLOW=
COMFYUI_OUTPUT_NODE=

INVOKEAI_ENDPOINT=
INVOKEAI_TOKEN=
INVOKEAI_TEXT_WORKFLOW=
INVOKEAI_EDIT_WORKFLOW=
INVOKEAI_OUTPUT_NODE=
