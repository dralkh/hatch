# Optional. Browser users can paste their own key into the page instead.
# Configure this as a Cloudflare secret for a shared deployment:
#   npx wrangler secret put FAL_KEY
FAL_KEY=

# Optional cloud image providers. Every provider remains selectable without a
# server key because a user can paste their own key into the page. A pasted key
# is held in that tab's memory and overrides the matching server key.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

XAI_API_KEY=
XAI_IMAGE_MODEL=grok-imagine-image-quality

OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image

GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image

# Optional server-proxy configuration for self-hosted local providers. ComfyUI
# and InvokeAI remain visible without these values for direct browser mode.
# For npm run dev, the engine is commonly reachable on 127.0.0.1.
# In Docker, use host.docker.internal and add the host-gateway mapping shown
# in README.md.
COMFYUI_ENDPOINT=
COMFYUI_TOKEN=
COMFYUI_TEXT_WORKFLOW=
COMFYUI_EDIT_WORKFLOW=
COMFYUI_OUTPUT_NODE=

INVOKEAI_ENDPOINT=
INVOKEAI_TOKEN=
INVOKEAI_TEXT_WORKFLOW=
INVOKEAI_EDIT_WORKFLOW=
INVOKEAI_OUTPUT_NODE=
